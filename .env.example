PORT=3001
HOST=0.0.0.0

# Base Progress Agentic RAG URL: https://<region>.dp.progress.cloud
# The region is shown in the agent's Settings section.
RAO_BASE_URL=

# Agent UUID, from the agent\'s Settings section.
RAO_AGENT_ID=
RAO_API_KEY=

# Required for the default ephemeral token endpoint template.
RAO_ACCOUNT_ID=

# Knowledge box UUID. For a RAO agent this is the same value as RAO_AGENT_ID; defaults to it if omitted.
RAO_KB_ID=

# Defaults to "default" and is passed as ?workflow_id= on every interaction.
RAO_WORKFLOW_ID=default

# Override these if your tenant/docs use slightly different paths.
# {session_id} is filled with the literal "ephemeral" (sessionMode=ephemeral) or a real
# session id (sessionMode=persistent). Both transports share the same session semantics.
RAO_SESSIONS_PATH_TEMPLATE=/api/v1/agent/{agent_id}/sessions
RAO_SESSION_PATH_TEMPLATE=/api/v1/agent/{agent_id}/session/{session_id}
RAO_EPHEMERAL_TOKENS_PATH_TEMPLATE=/api/v1/account/{account_id}/kb/{kb_id}/ephemeral_tokens
RAO_INTERACTION_PATH_TEMPLATE=/api/v1/agent/{agent_id}/session/{session_id}
RAO_WEBSOCKET_PATH_TEMPLATE=/api/v1/agent/{agent_id}/session/{session_id}/ws

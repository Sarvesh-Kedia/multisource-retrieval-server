PORT=3001
HOST=0.0.0.0

# Base Progress Agentic RAG URL, for example:
# https://<region>.rag.progress.cloud
RAO_BASE_URL=

RAO_AGENT_ID=
RAO_API_KEY=

# Required for the default ephemeral token endpoint template.
RAO_ACCOUNT_ID=

# Defaults to RAO_AGENT_ID if omitted.
RAO_KB_ID=

# Defaults to "default" and is passed as workflow_id in websocket query params.
RAO_WORKFLOW_ID=default

# Override these if your tenant/docs use slightly different paths.
RAO_SESSIONS_PATH_TEMPLATE=/api/v1/agent/{agent_id}/sessions
RAO_SESSION_PATH_TEMPLATE=/api/v1/agent/{agent_id}/sessions/{session_id}
RAO_EPHEMERAL_TOKENS_PATH_TEMPLATE=/api/v1/account/{account_id}/kb/{kb_id}/ephemeral_tokens
RAO_WEBSOCKET_PATH_TEMPLATE=/api/v1/agent/{agent_id}/session/ephemeral/ws
